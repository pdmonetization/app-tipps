---
import { SITE, PUBLISHER, INTEGRATIONS } from '../consts';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import InMobiConsent from '../components/InMobiConsent.astro';
import PurifyAdagio from '../components/PurifyAdagio.astro';
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  noindex?: boolean;
  ogImage?: string;
  ogType?: 'website' | 'article';
  schema?: object | object[];
  enableArticleInlineAd?: boolean;
}
const {
  title, description, canonical, noindex = false,
  ogImage = '/favicon.png',
  ogType = 'website', schema, enableArticleInlineAd = false,
} = Astro.props;

const url = canonical ?? new URL(Astro.url.pathname, SITE.url).href;
const image = new URL(ogImage, SITE.url).href;
const fullTitle = title.includes(SITE.name) ? title : `${title} | ${SITE.name}`;
const twitterCard = Astro.props.ogImage ? 'summary_large_image' : 'summary';

const organization = {
  '@type': 'Organization',
  '@id': `${SITE.url}/#organization`,
  name: SITE.name,
  url: `${SITE.url}/`,
  legalName: PUBLISHER.legalName,
  vatID: PUBLISHER.vatNumber,
  email: PUBLISHER.editorialEmail,
  description: SITE.description,
  foundingDate: String(SITE.founded),
  logo: {
    '@type': 'ImageObject',
    url: `${SITE.url}/favicon.png`,
    contentUrl: `${SITE.url}/favicon.png`,
    width: 512,
    height: 512,
  },
  contactPoint: {
    '@type': 'ContactPoint',
    contactType: 'Editorial enquiries',
    email: PUBLISHER.editorialEmail,
  },
  address: {
    '@type': 'PostalAddress',
    streetAddress: PUBLISHER.address.street,
    addressLocality: PUBLISHER.address.city,
    postalCode: PUBLISHER.address.postcode,
    addressCountry: PUBLISHER.address.countryCode,
  },
  sameAs: [PUBLISHER.social.facebook, PUBLISHER.social.instagram],
};
const website = {
  '@type': 'WebSite',
  '@id': `${SITE.url}/#website`,
  url: `${SITE.url}/`,
  name: SITE.name,
  description: SITE.description,
  inLanguage: SITE.lang,
  publisher: { '@id': `${SITE.url}/#organization` },
};
const graph = {
  '@context': 'https://schema.org',
  '@graph': [organization, website, ...(Array.isArray(schema) ? schema : schema ? [schema] : [])],
};
---
<!doctype html>
<html lang={SITE.lang}>
<head>
  {INTEGRATIONS.enableConsent && (
    <>
      {/* Default-denied Consent Mode v2 must precede every Google tag and the CMP SDK. */}
      <script is:inline>
        window.dataLayer = window.dataLayer || [];
        window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
        window.gtag('consent', 'default', {
          ad_storage: 'denied',
          ad_user_data: 'denied',
          ad_personalization: 'denied',
          analytics_storage: 'denied',
          wait_for_update: 500
        });
        window.gtag('set', 'ads_data_redaction', true);
        window['gtag_enable_tcf_support'] = true;
      </script>
      <InMobiConsent />
    </>
  )}
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{fullTitle}</title>
  <meta name="description" content={description} />
<meta name="mitgo-verification" content="732b2fca-b822-4d60-a28c-fca4cd41a139" />
  <link rel="canonical" href={url} />
  {noindex
    ? <meta name="robots" content="noindex, follow" />
    : <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />}
  {INTEGRATIONS.searchConsoleToken &&
    <meta name="google-site-verification" content={INTEGRATIONS.searchConsoleToken} />}

  {INTEGRATIONS.adsensePublisherId &&
    <meta name="google-adsense-account" content={INTEGRATIONS.adsensePublisherId} />}

  <meta property="og:site_name" content={SITE.name} />
  <meta property="og:locale" content={SITE.locale} />
  <meta property="og:type" content={ogType} />
  <meta property="og:title" content={fullTitle} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={url} />
  <meta property="og:image" content={image} />
  <meta name="twitter:card" content={twitterCard} />
  <meta name="twitter:title" content={fullTitle} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={image} />

  <link rel="icon" href="/favicon.ico" sizes="any" />
  <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />

  <script is:inline type="application/ld+json" set:html={JSON.stringify(graph)} />

  {enableArticleInlineAd && INTEGRATIONS.adManagerNetworkCode && (
    <>
      <script is:inline async src="https://securepubads.g.doubleclick.net/tag/js/gpt.js" crossorigin="anonymous"></script>
      <script is:inline>
        window.googletag = window.googletag || {cmd: []};
        googletag.cmd.push(function() {
          const slot = googletag.defineSlot(
            '/23368375120/app_tipps_article_inline_1',
            [300, 250],
            'div-gpt-ad-1787577808027-0'
          );

          if (slot) slot.addService(googletag.pubads());

          googletag.pubads().addEventListener('slotRenderEnded', function(event) {
            if (event.slot.getSlotElementId() !== 'div-gpt-ad-1787577808027-0') return;
            const container = document.querySelector('[data-gam-placement="article-inline-1"]');
            if (container && event.isEmpty) container.setAttribute('hidden', '');
          });

          googletag.pubads().enableSingleRequest();
          googletag.enableServices();
        });
      </script>
    </>
  )}

  {/* Load the account-level AdSense script for site verification. Ad slots remain
      disabled until enableAds is explicitly switched on after approval. */}
  {INTEGRATIONS.adsensePublisherId &&
    <script is:inline async crossorigin="anonymous"
      src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${INTEGRATIONS.adsensePublisherId}`}></script>}

  {INTEGRATIONS.ga4MeasurementId && (
    <>
      <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${INTEGRATIONS.ga4MeasurementId}`}></script>
      <script is:inline define:vars={{ id: INTEGRATIONS.ga4MeasurementId, consentEnabled: INTEGRATIONS.enableConsent }}>
        window.dataLayer = window.dataLayer || [];
        window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
        // InMobi handles subsequent Google Consent Mode v2 updates. Do not infer
        // Google Analytics permission from TCF Purpose 1 (device storage).
        if (!consentEnabled) {
          window.gtag('consent', 'default', {
            ad_storage: 'denied',
            ad_user_data: 'denied',
            ad_personalization: 'denied',
            analytics_storage: 'denied'
          });
        }
        window.gtag('js', new Date());
        window.gtag('config', id, { anonymize_ip: true });
      </script>
    </>
  )}
</head>
<body>
  <a class="skip" href="#main">Skip to content</a>
  <Header />
  <PurifyAdagio />
  <main id="main"><slot /></main>
  <Footer />
</body>
</html>
