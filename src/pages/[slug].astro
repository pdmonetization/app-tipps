---
import type { GetStaticPaths } from 'astro';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import GamArticleInline from '../components/GamArticleInline.astro';
import PostCard from '../components/PostCard.astro';
import TopicCluster from '../components/TopicCluster.astro';
import { allPosts, hasAffiliate, related } from '../lib/posts';
import { CATEGORY_SLUGS, slugifyTag } from '../lib/taxonomy';
import { authorUrl } from '../lib/authors';
import { editorialRatingFor } from '../lib/editorial-ratings';
import { publicResponsiveImage } from '../lib/responsive-images';
import { breadcrumbSchema } from '../lib/schema';
import { SITE } from '../consts';

export const getStaticPaths = (async () => {
  const posts = await allPosts();
  return posts.map((post) => ({
    params: { slug: post.data.slug },
    props: { post, pool: posts },
  }));
}) satisfies GetStaticPaths;

const { post, pool } = Astro.props;
const d = post.data;
const { Content } = await render(post);
const catSlug = CATEGORY_SLUGS[d.category] ?? 'news';
const url = `${SITE.url}/${d.slug}/`;
const authorPath = authorUrl(d.author);
const authorPage = new URL(authorPath, SITE.url).href;
const affiliate = hasAffiliate(post.body ?? '');
const heroImage = d.featuredImage ? await publicResponsiveImage(d.featuredImage) : undefined;
const rel = related(post, pool);
const published = d.publishDate.toISOString();
const modified = (d.updatedDate ?? d.publishDate).toISOString();
const fmt = (x: Date) => x.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
const isReview = d.category === 'Game Review' || d.category === 'App Review';
const rating = typeof d.rating === 'number' ? d.rating : editorialRatingFor(d.slug);
const reviewedName = d.title
  .replace(/\s+(?:game\s+|app\s+)?review\b.*$/i, '')
  .split(':')[0]
  .trim();
const reviewedType = d.category === 'Game Review' ? 'Game' : 'SoftwareApplication';
const hasReviewScore = isReview && typeof rating === 'number';
const authorSchema = d.author === 'App-Tipps Editorial'
  ? {
      '@type': 'Organization',
      '@id': `${authorPage}#editorial-team`,
      name: d.author,
      url: authorPage,
      parentOrganization: { '@id': `${SITE.url}/#organization` },
    }
  : { '@type': 'Person', '@id': `${authorPage}#person`, name: d.author, url: authorPage };

const article: any = {
  '@type': hasReviewScore ? 'Review' : 'Article',
  '@id': `${url}#article`,
  headline: d.title.slice(0, 110),
  description: d.description,
  datePublished: published,
  dateModified: modified,
  inLanguage: SITE.lang,
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  isPartOf: { '@id': `${SITE.url}/#website` },
  author: authorSchema,
  publisher: { '@id': `${SITE.url}/#organization` },
  ...(d.featuredImage ? { image: new URL(d.featuredImage, SITE.url).href } : {}),
  ...(hasReviewScore ? {
    itemReviewed: { '@type': reviewedType, name: reviewedName || d.title },
    reviewRating: { '@type': 'Rating', ratingValue: rating, bestRating: 5, worstRating: 1 },
  } : {}),
};
const breadcrumb = breadcrumbSchema(url, [
  { name: 'Home', url: `${SITE.url}/` },
  { name: d.category, url: `${SITE.url}/category/${catSlug}/` },
  { name: d.title },
]);
---
<Base title={d.seoTitle || d.title} description={d.description} canonical={d.canonicalUrl ?? url}
      noindex={d.noindex} ogType="article" ogImage={d.featuredImage} schema={[article, breadcrumb]}
      enableArticleInlineAd>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb">
      <a href="/">Home</a> / <a href={`/category/${catSlug}/`}>{d.category}</a>
    </nav>
    <article class="article">
      <a class="eyebrow" href={`/category/${catSlug}/`}>{d.category}</a>
      <h1>{d.title}</h1>
      <p class="standfirst">{d.description}</p>
      {hasReviewScore && (
        <div class="review-score" aria-label={`App-Tipps editorial score: ${rating.toFixed(1)} out of 5`}>
          <span>App-Tipps editorial score</span>
          <strong>{rating.toFixed(1)}<small>/5</small></strong>
        </div>
      )}
      <div class="meta">
        <span>By <a href={authorPath}>{d.author}</a></span>
        <span>Published <time datetime={published}>{fmt(d.publishDate)}</time></span>
        {d.updatedDate && d.updatedDate > d.publishDate &&
          <span>Updated <time datetime={modified}>{fmt(d.updatedDate)}</time></span>}
      </div>
      {d.correctionNote && (
        <p class="correction-note"><strong>Correction:</strong> {d.correctionNote}</p>
      )}
      {affiliate && (
        <p class="disclosure">
          This article contains affiliate links. If you buy or sign up through one, App-Tipps.com may
          earn a commission at no extra cost to you. It does not affect what we recommend &mdash; see our
          <a href="/editorial-policy/"> Editorial Policy</a>.
        </p>
      )}
      {d.featuredImage && heroImage && (
        <picture class="article-hero">
          {heroImage.webpSrcset && (
            <source type="image/webp" srcset={heroImage.webpSrcset}
              sizes="(max-width: 800px) calc(100vw - 32px), 760px" />
          )}
          <img src={d.featuredImage} alt={d.featuredImageAlt ?? d.title}
               width={heroImage.width} height={heroImage.height}
               fetchpriority="high" decoding="async" />
        </picture>
      )}
      <div class="article-body"><Content /></div>
      <TopicCluster currentSlug={d.slug} pool={pool} />
      <GamArticleInline />
      {d.tags.length > 0 && (
        <ul class="tags" aria-label="Tags">
          {d.tags.map((t) => <li><a href={`/tag/${slugifyTag(t)}/`}>{t}</a></li>)}
        </ul>
      )}
    </article>

    {rel.length > 0 && (
      <section aria-labelledby="rel">
        <h2 id="rel" style="margin:50px 0 0;font-size:22px">More from App-Tipps</h2>
        <div class="grid">{rel.map((p) => <PostCard post={p} />)}</div>
      </section>
    )}
  </div>
</Base>
