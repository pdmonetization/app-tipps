---
import Base from '../layouts/Base.astro';
import PostCard from '../components/PostCard.astro';
import { allPosts } from '../lib/posts';
const recent = (await allPosts()).slice(0, 3);
---
<Base title="This article has been withdrawn"
      description="This article is no longer published on App-Tipps.com." noindex={true}>
  <div class="wrap">
    <div class="page-head">
      <h1>This article has been withdrawn</h1>
      <p>
        We removed it because it no longer meets our editorial standards. It has not been replaced.
        Here is what we published most recently.
      </p>
    </div>
    <div class="grid">{recent.map((p) => <PostCard post={p} />)}</div>
  </div>
</Base>
