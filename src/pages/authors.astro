---
import Base from '../layouts/Base.astro';
import { AUTHORS } from '../lib/authors';
import { SITE } from '../consts';

const title = `Our Authors | ${SITE.name}`;
const description = `Meet the writers and editorial team behind ${SITE.name}, and browse articles published under each App-Tipps byline.`;
const url = `${SITE.url}/authors/`;
const schema = {
  '@type': 'CollectionPage',
  '@id': `${url}#authors`,
  name: 'Our Authors',
  url,
  description,
};
---
<Base {title} {description} canonical={url} schema={schema}>
  <div class="wrap">
    <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a> / Authors</nav>

    <header class="page-head" style="max-width:820px">
      <p class="eyebrow">Editorial team</p>
      <h1>Our Authors</h1>
      <p>
        App-Tipps has covered mobile apps and games since 2020. Our writers publish under consistent
        bylines, and each profile below links to the articles published under that name.
      </p>
      <p style="margin-top:14px;font-size:15px">
        Our standards for reviews, sourcing, corrections and commercial independence are explained in our
        <a href="/editorial-policy/">Editorial Policy</a>.
      </p>
    </header>

    <section aria-label="App-Tipps authors">
      <div class="grid">
        {AUTHORS.map((author) => (
          <article class="card">
            <p class="eyebrow">Author</p>
            <h2><a href={`/author/${author.slug}/`}>{author.name}</a></h2>
            <p>{author.bio}</p>
            <p><a href={`/author/${author.slug}/`}>View articles by {author.name}</a></p>
          </article>
        ))}
      </div>
    </section>
  </div>
</Base>
