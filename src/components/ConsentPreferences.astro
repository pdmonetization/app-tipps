---
// Google Funding Choices handles the actual consent message and stored preferences.
// This component provides a real, user-initiated entrypoint to reconsider a choice.
---
<li>
  <button id="app-tipps-privacy-choices" type="button" disabled hidden
    aria-label="Review privacy and cookie choices">
    Privacy and cookie settings
  </button>
  <span id="app-tipps-privacy-choices-status" role="status" aria-live="polite" class="sr-only"></span>
</li>
<style>
  button {background:none;border:0;padding:0;color:#cdd5e2;text-align:left;cursor:pointer;font:inherit;font-size:14.5px;text-decoration:underline}
  button:hover {color:white}
  button:disabled{cursor:default;opacity:.55}
  .sr-only{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}
</style>
<script is:inline>
(function(){
  const btn=document.getElementById('app-tipps-privacy-choices');
  const status=document.getElementById('app-tipps-privacy-choices-status');
  if(!btn || !status) return;
  const fc=window.googlefc=window.googlefc||{};
  fc.callbackQueue=fc.callbackQueue||[];
  function ready(){
    if(typeof window.googlefc?.showRevocationMessage !== 'function') return;
    // Funding Choices' revocation API is for European-regulations choices.
    if(typeof window.__tcfapi !== 'function') return;
    window.__tcfapi('addEventListener',2,function(tc,ok){
      if(!ok||!tc||typeof tc.gdprApplies !== 'boolean')return;
      btn.hidden = tc.gdprApplies===false;
      btn.disabled = tc.gdprApplies===false;
    });
  }
  fc.callbackQueue.push({CONSENT_API_READY:ready});
  // The message script sometimes becomes ready before this component executes.
  if(typeof fc.showRevocationMessage==='function')ready();
  btn.addEventListener('click',function(){
    if(typeof window.googlefc?.showRevocationMessage === 'function'){
      status.textContent='';
      window.googlefc.showRevocationMessage();
    }else{
      status.textContent='Privacy settings are temporarily unavailable. Please try reloading the page.';
    }
  });
})();
</script>
