---
/*
 * InMobi Choice is the only CMP. Do not set consent state from the footer:
 * reopen the provider's UI so the visitor can change or withdraw preferences.
 */
---
<li>
  <button id="app-tipps-privacy-choices" type="button" aria-label="Review privacy and cookie choices">
    Privacy and cookie settings
  </button>
  <span id="app-tipps-privacy-choices-status" role="status" aria-live="polite"></span>
</li>
<style>
  button { background:none;border:0;padding:0;color:#cdd5e2;text-align:left;cursor:pointer;font:inherit;font-size:14.5px;text-decoration:underline }
  button:hover,button:focus-visible { color:white }
  #app-tipps-privacy-choices-status:not(:empty) { display:block;max-width:30ch;font-size:12px;line-height:1.45;color:#ffd28e;margin-top:6px }
</style>
<script is:inline>
(function () {
  'use strict';
  const button = document.getElementById('app-tipps-privacy-choices');
  const status = document.getElementById('app-tipps-privacy-choices-status');
  if (!button || !status) return;

  let waiting = false;
  // Also used by the Purify owner-only diagnostics panel.
  window.appTippsOpenPrivacyChoices = function (report) {
    const notify = typeof report === 'function' ? report : function () {};
    const message = (value) => { status.textContent = value; notify(value); };
    if (waiting) return false;
    waiting = true;
    let attempts = 0;
    message('Opening privacy choices…');

    const fail = () => {
      waiting = false;
      message('InMobi consent settings did not load. Check the site property and browser blocking.');
    };
    const retry = () => {
      if (++attempts > 50) return fail();
      window.setTimeout(open, 100);
    };
    const open = () => {
      if (typeof window.__tcfapi !== 'function') return retry();
      try {
        window.__tcfapi('ping', 2, function (data) {
          if (!data || data.cmpStatus === 'stub' || data.cmpStatus === 'loading' || data.cmpLoaded === false) {
            return retry();
          }
          try {
            // InMobi publishes separate GDPR (TCF) and US privacy dialogs.
            if (data.gdprApplies === false && typeof window.__uspapi === 'function') {
              window.__uspapi('displayUspUi');
            } else {
              window.__tcfapi('displayConsentUi', 2, function () {});
            }
            waiting = false;
            message('');
          } catch (_error) { fail(); }
        });
      } catch (_error) { fail(); }
    };
    open();
    return true;
  };
  button.addEventListener('click', function () {
    window.appTippsOpenPrivacyChoices();
  });
})();
</script>
