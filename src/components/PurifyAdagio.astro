---
/* Public, multi-slot Purify/Adagio integration with optional AdSense no-fill backfill. */
import { INTEGRATIONS } from '../consts';
---
<div id="purify-top-mount" aria-label="Top advertisement"></div>
<div id="purify-sticky-mount" aria-label="Sticky advertisement"></div>
<style is:global>
  .article { position:relative; }
  .purify-ad { box-sizing:border-box; margin:28px auto; text-align:center; max-width:100%; }
  .purify-ad-label { font-size:10px; line-height:1.5; text-transform:uppercase;letter-spacing:.06em;color:#7a8493;margin-bottom:6px; }
  .purify-slot { margin:0 auto; max-width:100%; }
  .purify-ad[data-purify-result="no-bid"], .purify-ad[data-purify-result="slot-too-small"],
  .purify-ad[data-purify-result="render-error"], .purify-ad[data-purify-result="render-timeout"],
  .purify-ad[data-purify-result="library-error"] {display:none!important}
  .purify-top { margin:16px auto 26px; min-height:105px; }
  .purify-top .purify-slot {width:728px;min-height:90px;}
  .purify-article .purify-slot {width:300px;min-height:250px;}
  .purify-rail {position:absolute;top:360px;width:300px;min-height:600px;z-index:2;margin:0}
  .purify-rail-left {left:-322px}
  .purify-rail-right {right:-322px}
  .purify-rail .purify-slot {width:300px;min-height:600px}
  .purify-sticky {position:fixed;left:50%;bottom:0;transform:translateX(-50%);z-index:1000;
    margin:0;background:white;border:1px solid #d8dde5;border-bottom:0;box-shadow:0 -2px 12px #0002;
    padding:5px 28px 3px;max-width:100vw;visibility:hidden}
  .purify-sticky[data-purify-result="render-succeeded"] {visibility:visible}
  .purify-sticky .purify-slot {width:728px;min-height:90px;max-width:100%}
  .purify-close {position:absolute;top:4px;right:4px;border:0;background:#f2f4f7;color:#1b2637;
    font-size:18px;line-height:24px;width:24px;height:24px;cursor:pointer;border-radius:4px}
  #purify-diagnostics {position:fixed;right:12px;bottom:12px;max-width:420px;max-height:55vh;overflow:auto;
    font:12px/1.5 ui-monospace,Consolas,monospace;background:#111d2b;color:#e2ecf7;
    padding:12px;border-radius:8px;box-shadow:0 4px 30px #0005;z-index:2000}
  #purify-diagnostics table {border-collapse:collapse;width:100%}
  #purify-diagnostics td,#purify-diagnostics th {padding:3px 6px;border-bottom:1px solid #52606b}
  @media(max-width:1439px){.purify-rail {display:none!important}}
  @media(max-width:760px){
    .purify-top .purify-slot{width:320px;min-height:100px;max-width:100vw}
    .purify-top{margin:10px auto 15px}
    .purify-sticky .purify-slot{width:320px;min-height:50px}
    .purify-sticky{padding:0;width:320px;max-width:100vw;border:0}
    .purify-sticky .purify-close{top:-26px;right:0}
    .purify-article{position:relative;left:50%;transform:translateX(-50%);width:300px;max-width:calc(100vw - 8px)}
    .purify-article .purify-slot{width:300px;max-width:100%}
  }
</style>
<script is:inline define:vars={{ adsenseClient: INTEGRATIONS.adsensePublisherId, adsenseFallback: INTEGRATIONS.adsenseFallback }}>
(function(){
  'use strict';
  const LOADER='https://purify-prebid.pages.dev/dist/purify.js?v=1.0.1', VENDOR=617;
  // These statuses occur before any Prebid creative has started rendering.
  // A render-error or timeout may already represent a billable impression:
  // never send AdSense as a second provider after a render attempt.
  const NO_FILL = new Set(['no-bid', 'library-error', 'integration-error', 'no-prebid-consent']);
  const PENDING = new Set(['pending', 'auction-started', 'render-attempted']);
  const slots=[], seen=new Set(), debug=new URLSearchParams(location.search).get('purify_debug')==='1';
  let launched=false, registered=false, resolved=false, googleReady=false, attempts=0;
  let consentState='Waiting for InMobi Choice / TCF consent state';
  function log(message){if(debug)console.info('[Purify public]',message)}
  function create(name,area,mount,width,css='',adsenseHeight=0){
    if(!mount||seen.has(area))return;
    seen.add(area);
    const shell=document.createElement('aside');shell.className='purify-ad '+css;
    shell.dataset.purifyArea=area;shell.setAttribute('aria-label','Advertisement');
    const label=document.createElement('div');label.className='purify-ad-label';label.textContent='Advertisement';
    const slot=document.createElement('div');slot.className='purify-slot';slot.id='purify-app-tipps-'+area;
    slot.dataset.purifySlot=name;slot.style.width=width+'px';
    shell.append(label,slot);mount.append(shell);
    slots.push({name:area,purifyName:name,slot,shell,width,height:adsenseHeight,adsenseStarted:false});
    return shell;
  }
  function articleMiddle(body,n,area){
    const p=[...body.children].filter(el=>el.tagName==='P');
    if(p.length<n)return;
    const mark=document.createElement('div');p[n-1].after(mark);
    create('banner_middle',area,mark,300,'purify-article',250);
  }
  function setup(includeSticky=true){
    const mobile=matchMedia('(max-width:760px)').matches;
    create('banner_top','top',document.getElementById('purify-top-mount'),mobile?320:728,'purify-top',mobile?100:90);
    const article=document.querySelector('article.article'),body=article?.querySelector('.article-body');
    if(body){
      if(matchMedia('(min-width:1440px)').matches){
        create('banner_left','left',article,300,'purify-rail purify-rail-left',600);
        create('banner_right','right',article,300,'purify-rail purify-rail-right',600);
      }
      articleMiddle(body,3,'middle-1');
      articleMiddle(body,7,'middle-2');
      create('banner_bottom','bottom',body,300,'purify-article',250);
    }
    if(includeSticky && sessionStorage.getItem('purify_sticky_closed')!=='1'){
      const sticky=create('banner_sticky_bottom','sticky',document.getElementById('purify-sticky-mount'),mobile?320:728,'purify-sticky');
      if(sticky){
        const close=document.createElement('button');close.type='button';close.className='purify-close';
        close.textContent='×';close.setAttribute('aria-label','Close advertisement');
        close.onclick=()=>{sticky.remove();sessionStorage.setItem('purify_sticky_closed','1')};
        sticky.append(close);
      }
    }
  }
  function diagnostics(){
    if(!debug)return;
    let box=document.getElementById('purify-diagnostics');
    if(!box){box=document.createElement('section');box.id='purify-diagnostics';document.body.append(box)}
    const esc=s=>String(s||'').replace(/[&<>"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
    box.innerHTML='<strong>Purify Adagio — Live positions</strong>'+
      '<div>Consent: '+esc(consentState)+'</div>'+
      '<div>Selected bid ≠ billed impression; no refresh.</div>'+
      '<button type="button" id="purify-privacy-settings" style="margin:8px 0;cursor:pointer">Review privacy choices</button>'+
      '<div id="purify-privacy-result" role="status" aria-live="polite"></div>'+
      (slots.length?'<table><tr><th>Slot</th><th>Status</th><th>Bid CPM</th></tr>'+
      slots.map(x=>'<tr><td>'+esc(x.name)+'</td><td>'+esc(x.adsenseStarted?(x.shell.dataset.purifyResult||'adsense-requested'):x.slot.dataset.purifyStatus||'loading')+'</td><td>'+esc(x.slot.dataset.purifyBidCpm||'—')+'</td></tr>').join('')+'</table>':'<div>No auctions started.</div>');
    const review=box.querySelector('#purify-privacy-settings');
    // Never disable the entrypoint merely because InMobi loaded late.
    // The footer owns the documented queued CMP operation and reports failure.
    review.onclick=()=>{
      const output=document.getElementById('purify-privacy-result');
      if(typeof window.appTippsOpenPrivacyChoices==='function'){
        window.appTippsOpenPrivacyChoices(message=>{
          if(output)output.textContent=message;
        });
      }else if(output){
        output.textContent='Privacy control is unavailable on this page; please use the privacy link in the footer.';
      }
    };
  }
  function requestAdsenseFallback(x, reason){
    if(!NO_FILL.has(reason) || x.adsenseStarted || !googleReady || !adsenseFallback?.enabled || !x.height)return false;
    if(window.navigator?.globalPrivacyControl === true)return false;
    const unit=adsenseFallback.slotIds?.[x.purifyName];
    // A publisher ID alone is not an ad unit. Never make an AdSense request
    // without a real, account-issued numeric data-ad-slot value.
    if(!/^ca-pub-\d+$/.test(adsenseClient) || typeof unit!=='string' || !/^\d{1,16}$/.test(unit))return false;
    // Only load if the configured placement really fits on screen.
    if(x.slot.getBoundingClientRect().width < x.width || x.slot.querySelector('iframe'))return false;

    const ins=document.createElement('ins');
    ins.className='adsbygoogle';
    ins.style.display='inline-block';
    ins.style.width=x.width+'px';
    ins.style.height=x.height+'px';
    ins.setAttribute('data-ad-client',adsenseClient);
    ins.setAttribute('data-ad-slot',unit);

    // Once the Google request is queued, never hide, refresh or replace it
    // even if a later provider callback or a consent change occurs.
    x.adsenseStarted=true;
    x.shell.dataset.purifyResult='adsense-requested';
    x.slot.replaceChildren(ins);
    // Distinguish an actual Google fill from a request that returned no ad.
    // This does not reload, refresh, hide or replace an AdSense creative.
    if(typeof MutationObserver==='function'){
      const observer=new MutationObserver(()=>{
        const result=ins.getAttribute('data-ad-status');
        if(result==='filled'||result==='unfilled'){
          x.shell.dataset.purifyResult='adsense-'+result;
          observer.disconnect();
          diagnostics();
        }
      });
      observer.observe(ins,{attributes:true,attributeFilter:['data-ad-status']});
    }
    try{
      (window.adsbygoogle=window.adsbygoogle||[]).push({});
      log('AdSense fallback requested',{area:x.name,prebidStatus:reason});
    }catch(error){
      // Do not retry: Google may have accepted the impression before throwing.
      x.shell.dataset.purifyResult='adsense-error';
      warnFallback(error);
    }
    return true;
  }
  function warnFallback(error){
    if(debug)console.warn('[App-Tipps AdSense fallback]',error);
  }
  function statuses(){
    for(const x of slots){
      if(x.adsenseStarted)continue;
      const s=x.slot.dataset.purifyStatus;
      if(requestAdsenseFallback(x,s))continue;
      if(s&&!PENDING.has(s))x.shell.dataset.purifyResult=s;
    }
    diagnostics();
  }
  function start(){
    // If a Google ad was already requested because no Prebid bidder was
    // consent-eligible, do not start a competing auction on the same view.
    if(launched||!resolved||slots.some(x=>x.adsenseStarted))return;
    launched=true;setup();if(!slots.length)return;
    const observer=new MutationObserver(statuses);
    for(const x of slots)observer.observe(x.slot,{attributes:true,attributeFilter:['data-purify-status','data-purify-bid-cpm']});
    if(debug){window.PURIFY_DEBUG=true;diagnostics()}
    const s=document.createElement('script');s.src=LOADER;s.async=true;s.dataset.purifySite='app-tipps';
    s.onerror=()=>{
      log('Prebid loader failed');
      // No creative was attempted when the loader itself failed.
      for(const x of slots)x.slot.dataset.purifyStatus='library-error';
      statuses();
    };
    document.head.append(s);
    log('Started live Adagio auction for '+slots.length+' placements');
  }
  function setConsentState(value){
    consentState=value;
    if(debug)diagnostics();
    log(value);
  }
  function onConsent(tc,ok){
    if(!ok||!tc){setConsentState('TCF response unavailable; no ad request');return}
    // A manual AdSense request must wait for InMobi to finish processing TCF
    // choices, not merely for its stub to become available. Google handles
    // personalized/nonpersonalized/limited ad eligibility from the TC string.
    const complete=tc.gdprApplies===false ||
      (tc.gdprApplies===true && Boolean(tc.tcString) &&
       ['tcloaded','useractioncomplete'].includes(tc.eventStatus));
    if(!complete){
      setConsentState('Waiting for completed TCF choice ('+String(tc.eventStatus||'unknown')+')');
      return;
    }
    if(window.navigator?.globalPrivacyControl===true){
      googleReady=false;
      resolved=false;
      setConsentState('GPC privacy opt-out: no new ad requests');
      return;
    }

    const adagioEligible=tc.gdprApplies===false ||
      Boolean(tc.purpose?.consents?.[1]===true&&tc.vendor?.consents?.[VENDOR]===true);

    if(!adagioEligible){
      // Adagio consent (vendor 617) is independent of Google demand. The
      // publisher must not suppress AdSense merely because Adagio cannot bid.
      // InMobi provides the finalized TCF/GPP signal to Google, which decides
      // whether personalized, non-personalized or limited ads are permissible.
      resolved=false;
      googleReady=!launched;
      if(launched){
        // A previously started auction may already contain billable ads:
        // never start a second provider on these placements mid-view.
        slots.forEach(x=>{if(!x.adsenseStarted)x.shell.remove()});
        setConsentState('Adagio permission withdrawn: no new ads this view');
        return;
      }
      setup(false);
      for(const x of slots){
        if(!x.adsenseStarted&&!x.slot.dataset.purifyStatus){
          x.slot.dataset.purifyStatus='no-prebid-consent';
        }
      }
      statuses();
      setConsentState('Adagio not authorized; Google fallback eligible where configured');
      return;
    }

    googleReady=true;
    resolved=true;
    setConsentState(tc.gdprApplies===false?'CMP confirms GDPR does not apply; other applicable opt-outs must still be respected':'Adagio vendor 617 consent confirmed');
    start();
  }
  function awaitCMP(){
    if(launched||registered)return;
    if(typeof window.__tcfapi==='function'){
      registered=true;
      setConsentState('CMP found; awaiting final TCF decision');
      try{window.__tcfapi('addEventListener',2,onConsent)}catch(error){
        setConsentState('TCF listener error: '+String(error.message));
      }
    }else if(++attempts<100)setTimeout(awaitCMP,100);
    else setConsentState('CMP unavailable after 10 seconds; no auction');
  }
  if(debug){window.PURIFY_DEBUG=true;diagnostics()}
  if(document.readyState==='loading')document.addEventListener('DOMContentLoaded',awaitCMP,{once:true});
  else awaitCMP();
})();
</script>
