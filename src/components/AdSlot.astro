---
/* Renders nothing until INTEGRATIONS.enableAds is true and an AdSense
   publisher ID exists. Drop-in point for AdSense or GPT later. */
import { INTEGRATIONS } from '../consts';
interface Props { slot?: string; label?: string; }
const { slot = '', label = 'in-article' } = Astro.props;
const on = INTEGRATIONS.enableAds && !!INTEGRATIONS.adsensePublisherId;
---
{on ? (
  <div class="ad-slot" data-ad-placement={label}>
    <ins class="adsbygoogle" style="display:block" data-ad-client={INTEGRATIONS.adsensePublisherId}
         data-ad-slot={slot} data-ad-format="auto" data-full-width-responsive="true"></ins>
    <script is:inline>(adsbygoogle = window.adsbygoogle || []).push({});</script>
  </div>
) : null}
